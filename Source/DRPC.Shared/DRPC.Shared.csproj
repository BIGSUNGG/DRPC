<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DRPC.Shared</PackageId>
    <Description>Shared runtime for DRPC — a distributed RPC library for .NET that runs over reliable UDP. Contains HubBase (pending-call table with per-call timeouts, cancellation tokens, and pending/incoming concurrency caps), the wire message model (one-way calls signal CallId 0), the structured error model surfaced as RpcFaultException with typed RpcErrorCode values, and incoming routing. Transport (RUDP with optional DTLS 1.2 encryption and certificate pinning) comes from DS_Communication; serialization from DS_MessageProtocol. Common foundation of the DRPC.Client and DRPC.Server packages — reference it alongside DRPC.Attribute in the contract project shared by both sides. Targets netstandard2.1 for modern .NET and Unity 2021.2+.</Description>
    <RootNamespace>DRPC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 직렬화 = DS_MessageProtocol (NuGet), 전송 = DS_Communication RUDP (NuGet). 형제 저장소 소스는 참조하지 않는다. -->
    <PackageReference Include="MessageProtocol" Version="$(MessageProtocolPackageVersion)" />
    <PackageReference Include="Communication.Shared" Version="$(CommunicationPackageVersion)" />
    <PackageReference Include="Communication.Network.RUDP.Shared" Version="$(CommunicationPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DRPC.Attribute\DRPC.Attribute.csproj" />
  </ItemGroup>

</Project>
