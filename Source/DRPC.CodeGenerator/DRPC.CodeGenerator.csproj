<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DRPC.CodeGenerator</PackageId>
    <Description>Roslyn source generator for DRPC — a distributed RPC library for .NET that runs over reliable UDP. Scans hub classes for [RemoteProcedure] contracts and emits the entire RPC plumbing at build time: typed async client stubs ({Method}Async), incoming dispatch with {Method}_Implementation hooks, connection wiring (ConnectAsync / ListenAsync), and flat payload encoding — you never write transport or serialization code. Contract mistakes such as duplicate method ids, unsupported signatures, or undeclared generic arguments surface as DRPCGEN compile-time diagnostics. Reference it as an analyzer (OutputItemType="Analyzer" ReferenceOutputAssembly="false") in every project that declares or implements a hub. Targets netstandard2.0.</Description>
    <PackageTags>DRPC;Roslyn;SourceGenerator;Analyzer</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsPackable>true</IsPackable>
    <!-- 생성기는 호스트(Roslyn)가 netstandard2.0 을 요구. 런타임 프로젝트와 TFM 이 다른 것은 정상. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS1035;RS2008;RS1032;RS1041</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAnalyzerAssembliesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="AddAnalyzerAssembliesToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynAnalyzerApiVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!--
    DRPC 계약 타입·MessageProtocol 속성은 이름 문자열로 탐지한다(프로젝트 참조 없음).
    직렬화 생성은 소비 프로젝트의 MessageProtocol 생성기가 담당하므로 이 생성기는 CodeAnalysis 만 필요하다.
  -->

</Project>
