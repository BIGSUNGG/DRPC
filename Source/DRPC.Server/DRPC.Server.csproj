<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DRPC.Server</PackageId>
    <Description>Server-side runtime for DRPC — a distributed RPC library for .NET that runs over reliable UDP. Provides the server hub and RUDP listener: accept connections gated by connection keys, cap pending and incoming work per hub, authorize requests through an override hook before method lookup, and enable optional DTLS 1.2 packet encryption with server certificates. Implement your contract via the generated partial {Method}_Implementation methods and call back into connected clients over the same typed stubs. Use it with DRPC.Shared to build real-time service backends for modern .NET and Unity 2021.2+ clients. Targets netstandard2.1.</Description>
    <RootNamespace>DRPC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Communication.Network.RUDP.Server" Version="$(CommunicationPackageVersion)" />
    <PackageReference Include="Communication.Network.RUDP.Shared" Version="$(CommunicationPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DRPC.Shared\DRPC.Shared.csproj" />
  </ItemGroup>

</Project>
