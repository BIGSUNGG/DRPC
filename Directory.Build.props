<Project>



  <PropertyGroup>



    <!-- netstandard2.0 기본 언어 버전(C# 7.3)에서는 Nullable 등과 호환되지 않음 -->



    <LangVersion>latest</LangVersion>



    <!-- 예제·앱 프로젝트는 기본 비패키징; Source/ 하위에서 true로 재정의 -->



    <IsPackable>false</IsPackable>



    <!-- NuGet MessageProtocol.* 패키지 버전 (여러 프로젝트에서 공통 참조) -->



    <MessageProtocolPackageVersion>3.1.0</MessageProtocolPackageVersion>



    <!-- NuGet Communication.* (DS_Communication) 패키지 버전 -->



    <CommunicationPackageVersion>2.7.0</CommunicationPackageVersion>



  </PropertyGroup>



  <!-- MessageProtocol 생성기가 [module: ModuleInitializer] 사용 시 netstandard2.x에서 필요 -->



  <ItemGroup>

    <PackageReference Include="PolySharp" Version="1.14.1">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

    </PackageReference>

  </ItemGroup>




  <!--
    제너레이터가 참조하는 Roslyn 컴파일러 API 버전.
    Unity 에디터(6000.3 = Roslyn 4.3)용 재빌드 시 -p:RoslynAnalyzerApiVersion=4.3.0 으로 오버라이드한다.
    (CS9057: 분석기가 호스트 컴파일러보다 새 Roslyn 을 참조하면 Unity 가 제너레이터를 스킵한다)
    -unity 접미사 패키지 작성·검증·로컬 피드 배치 전체 절차: Document/03-Reference/Packages.md
  -->
  <PropertyGroup>
    <RoslynAnalyzerApiVersion>4.14.0</RoslynAnalyzerApiVersion>
  </PropertyGroup>
</Project>

