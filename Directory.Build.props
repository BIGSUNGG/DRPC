<Project>



  <PropertyGroup>



    <!-- netstandard2.0 기본 언어 버전(C# 7.3)에서는 Nullable 등과 호환되지 않음 -->



    <LangVersion>latest</LangVersion>



    <!-- 예제·앱 프로젝트는 기본 비패키징; Source/ 하위에서 true로 재정의 -->



    <IsPackable>false</IsPackable>



    <!-- NuGet MessageProtocol.* 패키지 버전 (여러 프로젝트에서 공통 참조) -->



    <MessageProtocolPackageVersion>3.2.1</MessageProtocolPackageVersion>



    <!-- NuGet Communication.* (DS_Communication) 패키지 버전 -->



    <CommunicationPackageVersion>2.7.1</CommunicationPackageVersion>



  </PropertyGroup>



  <!-- MessageProtocol 생성기가 [module: ModuleInitializer] 사용 시 netstandard2.x에서 필요 -->



  <ItemGroup>

    <PackageReference Include="PolySharp" Version="1.14.1">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

    </PackageReference>

  </ItemGroup>




  <!--
    제너레이터가 참조하는 Roslyn 컴파일러 API 버전.
    3.5.0부터 메인라인 기본 = 4.3.0 — Unity 6 에디터(번들 Roslyn 4.3.0.0)에서 CS9057 스킵 없이 직접 구동된다.
    상위 Roslyn(예: 4.14) 참조 시 호스트 컴파일러가 더 낡으면(CS9057) Unity 가 제너레이터를 스킵하므로,
    새 Roslyn API 를 쓰려는 특별한 사유가 없는 한 4.3 을 유지한다.
    유니티 피드·검증 절차: Document/03-Reference/Packages.md
  -->
  <PropertyGroup>
    <RoslynAnalyzerApiVersion>4.3.0</RoslynAnalyzerApiVersion>
  </PropertyGroup>
</Project>

